# ─────────────────────────────────────────────────────────────────────────────
# SAB Account AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────


# ── SUPABASE ──────────────────────────────────────────────────────────────────

# Your Supabase project URL — safe to expose publicly
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous key — public, respects Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SECRET, bypasses RLS, server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ── STRIPE ────────────────────────────────────────────────────────────────────

# Stripe secret key for server-side API calls (charges, subscriptions, portals)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key

# Webhook signing secret — used to verify Stripe events are genuine
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price ID for the Starter plan ($9/mo) — copy from Stripe dashboard
STRIPE_PRICE_STARTER=price_your-starter-price-id

# Stripe Price ID for the Pro plan ($19/mo) — copy from Stripe dashboard
STRIPE_PRICE_PRO=price_your-pro-price-id

# Stripe Price ID for the Autopilot add-on — copy from Stripe dashboard
STRIPE_PRICE_AUTOPILOT=price_your-autopilot-price-id


# ── ANTHROPIC ─────────────────────────────────────────────────────────────────

# Claude API key — used by all agents and the AI chat feature
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key


# ── EMAIL (RESEND) ────────────────────────────────────────────────────────────

# Resend API key — used for all transactional emails (invoices, payslips, onboarding)
RESEND_API_KEY=re_your-resend-api-key

# Sender address for all outgoing emails — must be a verified Resend domain
EMAIL_FROM=hello@sabaccountai.com


# ── AGENT SECRETS ─────────────────────────────────────────────────────────────

# Bearer token for agent-to-agent HTTP auth (all /api/agents/* routes check this)
AGENT_WEBHOOK_SECRET=your-agent-webhook-secret-here

# Bearer token for Vercel cron route auth (all /api/cron/* routes check this)
CRON_SECRET=your-cron-secret-here

# Secret for internal email queue API calls (onboarding-emails → queue → email routes)
INTERNAL_API_SECRET=your-internal-api-secret-here

# 32-byte hex key for AES-256 encryption of employee TFNs at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Founder email for agent error alerts and critical notifications
FOUNDER_EMAIL=your-email@example.com


# ── EXTERNAL APIs ─────────────────────────────────────────────────────────────

# Tavily API key — web search + content extraction used by Spark, Kite, Bridge, Scout
TAVILY_API_KEY=tvly-your-tavily-api-key

# ABR (Australian Business Register) GUID for ABN lookups
# Apply at: abr.business.gov.au/Tools/WebServices
ABR_API_GUID=your-abr-guid-here

# Pexels stock photo API key — used for AI blog post featured images
PEXELS_API_KEY=your-pexels-api-key

# GitHub personal access token — Flux agent uses this to open PRs with code fixes
GITHUB_TOKEN=ghp_your-github-token

# GitHub repo in owner/repo format — Flux agent opens PRs against this repo
GITHUB_REPO=your-username/your-repo


# ── SOCIAL (Instagram, LinkedIn) ─────────────────────────────────────────────

# Instagram Graph API long-lived access token — Spark agent posts content here
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# Instagram Business account ID — found in Meta Business Suite
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# LinkedIn OAuth access token — Spark agent posts articles and updates here
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# LinkedIn author URN — format: urn:li:person:your-id (found in LinkedIn API response)
LINKEDIN_AUTHOR_URN=urn:li:person:your-linkedin-id

# LinkedIn OAuth app client ID — for refreshing the access token
LINKEDIN_CLIENT_ID=your-linkedin-client-id

# LinkedIn OAuth app client secret — for refreshing the access token
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret


# ── TELEGRAM ──────────────────────────────────────────────────────────────────

# Telegram bot token — agent alerts and Basnet voice commands come through this bot
# Create a bot at t.me/BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Telegram chat or channel ID to send agent alerts to (your personal chat ID)
TELEGRAM_CHAT_ID=your-chat-id-here

# Secret for verifying incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret


# ── REDIS / UPSTASH ───────────────────────────────────────────────────────────

# Upstash Redis REST URL — used for API rate limiting and profile caching
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io

# Upstash Redis REST token — paired with the URL above
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# QStash token — durable email queue (Stripe webhook enqueues emails via QStash)
QSTASH_TOKEN=your-qstash-token

# QStash signing keys — used to verify that queued requests came from QStash
QSTASH_CURRENT_SIGNING_KEY=sig_your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=sig_your-next-signing-key


# ── APP CONFIG ────────────────────────────────────────────────────────────────

# Public-facing app URL — used in cron-to-agent callbacks and OAuth redirect URIs
NEXT_PUBLIC_APP_URL=https://sabaccountai.com

# URL of the local Basnet voice agent HTTP server (basnet_voice2.py runs on this)
# Only needed on the machine running the local agent — not required on Vercel
LOCAL_AGENT_URL=http://127.0.0.1:3099

# Absolute path to project directory on the local machine
# Used by Telegram agent for shell commands via the local agent bridge
# Only needed on the machine running the local agent — not required on Vercel
PROJECT_DIR=/path/to/your/project
