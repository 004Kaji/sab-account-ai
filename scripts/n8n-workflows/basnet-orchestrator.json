      "parameters": {
        "jsCode": "\nconst q = ($input.first().json.body?.question ?? '').toLowerCase();\nconst routes = {\n  technical: ['error','bug','deploy','code','payg','stripe','supabase','sentry','status','broken'],\n  health:    ['churn','mrr','users','paid','revenue','conversion','retention'],\n  intel:     ['competitor','xero','myob','market','pricing','ato','news'],\n  marketing: ['tiktok','blog','content','hook','linkedin','instagram','post'],\n};\nlet route = 'ask';\nfor (const [r, kw] of Object.entries(routes)) {\n  if (kw.some(k => q.includes(k))) { route = r; break; }\n}\nconst isMulti = ['how is everything','full report','status report','run all agents'].some(k=>q.includes(k));\nreturn [{ question: $input.first().json.body?.question ?? '', route, isMulti }];\n"
      },
